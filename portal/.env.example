# Copy this to .env (never commit .env)
# Set all these as Supabase Edge Function secrets (see setup guide)

# Supabase project
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # from Supabase dashboard → Settings → API

# Zoho API console credentials
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Must match the Redirect URI registered in Zoho API console exactly
ZOHO_REDIRECT_URI=https://<your-project-ref>.supabase.co/functions/v1/zoho-oauth-callback
